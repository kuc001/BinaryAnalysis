# 忽略 Python 编译缓存和开发文件
__pycache__/
*.py[cod]
*$py.class

# 忽略 setuptools 生成的 egg-info 目录
*.egg-info/
dist/
build/

# 忽略虚拟环境目录（按需添加）
.venv/
**/.venv/
venv/
venv*/
.env/
.env*/

# 其他常见忽略项（可选）
.pytest_cache/
.coverage

.DS_Store
.idea/
*.swp
*.swo

# P1 isolated probes, native caches, and immutable local evidence
.p1-work/

# P2 model regression and immutable integrity evidence
.p2-work/

# P3 typed CIR / memory contract evidence
.p3-work/

# P4 isolated native lifting and immutable evidence
.p4-work/

# P5 memory conformance, native solver probes and immutable evidence
.p5-work/

# P6 isolated dataflow/target comparisons and immutable evidence
.p6-work/

# P7 isolated CLI outputs, characterization and immutable evidence
.p7-work/
