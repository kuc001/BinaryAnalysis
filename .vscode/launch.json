
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BinaryAnalysis: cs15 Alias Benchmark",
            "type": "debugpy",
            "request": "launch",

            // Python解释器
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

            // 等价于 python -m emtaint
            "module": "emtaint",

            // Python解释器参数，等价于 -B
            "pythonArgs": [
                "-B"
            ],

            // emtaint模块接收的命令行参数
            "args": [
                "-i",
                "-f",
                "D:\\works\\dataflow\\EmTaint\\BinaryAnalysis-worktrees\\firmware-binaries\\rv130_v44\\httpd",
                "--site",
                "0x1D688",

                "--output",
                "datas\\icall\\httpd\\0x1d688-debug",

                "--log-level",
                "DEBUG",
                "--log-file",
                "runtime-debug.json",
                "--log-format",
                "jsonl",
                "--log-console",
                "--log-console-level",
                "INFO"
            ],

            // 工作目录
            "cwd": "${workspaceFolder}",

            // 使用集成终端
            "console": "integratedTerminal",

            // 允许进入第三方库调试
            "justMyCode": false,

            // 发生异常时保持调试信息
            "stopOnEntry": false
        }
    ]
}
